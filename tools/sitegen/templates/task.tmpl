<!doctype html>
<html lang="en">
{{template "head" .Head}}
<body>
{{template "header" .}}
<main>
<nav aria-label="Breadcrumb">
<ol class="crumbs">
<li><a href="{{h .Base}}/">All retired tasks</a></li>
<li aria-current="page">{{h .E.Task}}</li>
</ol>
</nav>
<h1>{{h .E.Heading}}</h1>
<section aria-labelledby="answer">
<h2 id="answer">The short answer</h2>
<dl class="facts">
<dt>Retirement date</dt>
<dd><time datetime="{{h .Cfg.RetirementDate}}">{{h .Cfg.RetirementDate}}</time></dd>
<dt>Removal date</dt>
<dd><time datetime="{{h .Cfg.RemovalDate}}">{{h .Cfg.RemovalDate}}</time>. Pipelines that still use it fail after removal.</dd>
<dt>Replacement</dt>
<dd>{{if and (eq .E.Class "D") .E.Replacement}}Closest task: {{range $i, $r := .E.Replacement}}{{if $i}} and {{end}}<code>{{h $r}}</code>{{end}} (after the migration described below).{{else if .E.Replacement}}{{range $i, $r := .E.Replacement}}{{if $i}} and {{end}}<code>{{h $r}}</code>{{end}}{{else}}No replacement task.{{end}}</dd>
<dt>Kind of migration</dt>
<dd>{{h .E.ClassLabel}}</dd>
<dt>Automatic rewrite</dt>
<dd>{{h .E.AutoText}}</dd>
<dt>Recommended action</dt>
<dd>{{h .E.Action}}</dd>
</dl>
<h3>Official sources</h3>
<ul>
{{- range .E.Sources}}
<li><a href="{{h .URL}}">{{h .Label}}</a></li>
{{- end}}
</ul>
<p>Last verified: <time datetime="{{h .Cfg.Generated}}">{{h .Cfg.Generated}}</time></p>
</section>
<section aria-labelledby="find">
<h2 id="find">Find it in your pipelines</h2>
{{- if .Cfg.ToolAvailable}}
<p>With trasloco:</p>
<pre><code>trasloco modernize --check</code></pre>
<p><a href="https://github.com/HarnageaGabriel/trasloco/releases/latest">Install trasloco from the latest release</a>.</p>
{{- end}}
<p>With plain grep, nothing to install:</p>
<pre><code>{{h .E.Grep}}</code></pre>
</section>
{{- if .E.Example}}
<section aria-labelledby="example">
<h2 id="example">Before and after</h2>
<p>Only the task line changes. Review the replacement inputs before you commit.</p>
<h3>Before</h3>
<pre><code>{{h .E.Example.Before}}</code></pre>
<h3>After</h3>
<pre><code>{{h .E.Example.After}}</code></pre>
</section>
{{- else}}
<section aria-labelledby="migrate">
<h2 id="migrate">How to migrate</h2>
<p>{{h .E.Action}}</p>
{{- if .E.Replacement}}
<p>The task definition of the replacement is linked under official sources above.</p>
{{- end}}
</section>
{{- end}}
<section aria-labelledby="faq">
<h2 id="faq">Questions</h2>
{{- range .FAQ}}
<h3>{{h .Question}}</h3>
<p>{{h .Answer}}</p>
{{- end}}
</section>
</main>
{{template "footer" .}}
</body>
</html>
